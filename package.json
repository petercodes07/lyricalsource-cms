{
  "name": "lyricalsource-cms",
  "version": "1.0.0",
  "description": "Private editorial CMS for LyricalSource",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup:local": "node scripts/setup-local.js",
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.js",
    "backup": "node scripts/backup.js",
    "desktop:setup": "npm ci --prefix desktop",
    "desktop": "npm start --prefix desktop",
    "desktop:demo": "npm run demo --prefix desktop",
    "desktop:dist": "npm run dist --prefix desktop",
    "desktop:test": "npm test --prefix desktop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "sanitize-html": "^2.18.0"
  }
}
